{
	"enabledPlugins": {
		"fabrika@kampus": true,
		"kampus-pipeline@kampus": false
	},
	"extraKnownMarketplaces": {
		"kampus": {
			"source": {
				"source": "github",
				"repo": "kamp-us/phoenix"
			},
			"autoUpdate": true
		}
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Read|Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/plant-link-pretooluse.sh\""
					}
				]
			},
			{
				"matcher": "Read|Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/guard.sh\" worktree-guard pre-file"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/guard.sh\" worktree-guard pre-bash"
					}
				]
			},
			{
				"matcher": "EnterWorktree",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/guard.sh\" worktree-guard pre-enter"
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/guard.sh\" worktree-guard reap"
					}
				]
			}
		],
		"WorktreeCreate": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/create-worktree.sh\"",
						"timeout": 600
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/install.sh\"",
						"timeout": 120
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR/claude-plugins/kampus-pipeline/hooks/worktree-sweep-detach.sh\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
