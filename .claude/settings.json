{
	"enabledPlugins": {
		"fabrika@kampus": true
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "fabrika hook plugin-sync",
						"timeout": 120
					}
				]
			}
		],
		"WorktreeCreate": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "fabrika hook worktree-create",
						"timeout": 600
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(fabrika build *)",
			"Bash(fabrika lane *)",
			"Bash(node packages/fabrika-cli/src/bin.ts build *)",
			"Bash(node packages/fabrika-cli/src/bin.ts lane *)"
		]
	}
}
