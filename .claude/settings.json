{
	"enabledPlugins": {
		"fabrika@kampus": true,
		"kampus-pipeline@kampus": false
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "fabrika hook plugin-sync",
						"timeout": 120
					}
				]
			}
		],
		"WorktreeCreate": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "fabrika hook worktree-create",
						"timeout": 600
					}
				]
			}
		]
	}
}
