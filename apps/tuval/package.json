{
	"name": "@kampus-apps/tuval",
	"version": "0.0.0",
	"private": true,
	"description": "Tuval — a local runnable app (ADR 0345): the desk and the programs that ship in the box, on the @kampus/tuval-sdk kernel",
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "node src/bin.ts",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict && tsc -p tsconfig.design.json && effect-tsgo diagnostics --project tsconfig.design.json --strict && tsc -p tsconfig.browser.json && effect-tsgo diagnostics --project tsconfig.browser.json --strict",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:browser": "playwright test",
		"test:browser:install": "playwright install chromium",
		"proof:board": "vite --config src/shell/board/proof/vite.config.ts",
		"proof:chat": "vite --config src/chat/proof/vite.config.ts",
		"proof:pi-window": "vite --config src/pi-desk/window-proof/vite.config.ts",
		"proof:picker": "vite --config src/shell/picker/proof/vite.config.ts",
		"proof:page-reconnect": "node src/page/proof/serve.ts",
		"proof:pi-vertical": "node src/pi-desk/proof/serve.ts",
		"proof:claude-real": "node src/claude-desk/proof/serve.ts"
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/design": "workspace:*",
		"@kampus/tuval-agy": "workspace:*",
		"@kampus/tuval-claude": "workspace:*",
		"@kampus/tuval-codex": "workspace:*",
		"@kampus/tuval-pi": "workspace:*",
		"@kampus/tuval-sdk": "workspace:*",
		"@kampus/tuval-ui": "workspace:*",
		"@manti-ui/styles": "catalog:",
		"effect": "catalog:",
		"fzf": "catalog:tuval",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-resizable-panels": "catalog:",
		"ws": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@playwright/test": "catalog:",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/ws": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"axe-core": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
