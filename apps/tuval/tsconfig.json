{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// This is the Node lens over all of `src`: it has Node types, so a browser-only slice cannot
		// be caught here. The browser entry has its own lens, `tsconfig.browser.json`, rooted at
		// `src/page/main.tsx` with no Node types, so a `node:` import reachable from the page is a
		// plain type error there (#7836). `typecheck` runs both. Each Node-only slice still keeps
		// itself that way through its own `boundary.unit.test.ts`.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		// Off for the cause apps/web's `tsconfig.app.json` turns it off: `@kampus/design` is consumed
		// as source, and the `@manti-ui/react` declarations under it spell an optional prop `foo?: T`
		// where React's own attribute types spell `foo?: T | undefined`. Measured at #7851's head,
		// `--exactOptionalPropertyTypes` gives 8 errors on this lens and 8 on the browser one, and
		// every one of them is in `packages/design/src` (`AgentChatInput` ×3, `Avatar`, `Button`,
		// `CommandPalette`, `CountToggle`, `Switch`) — no `apps/tuval` file is among them, and #7856
		// is the route back to `true`. An optional prop authored here spells its own `| undefined`
		// so it stays clean under the flag; the optional-key idiom
		// (`...(x === undefined ? {} : {x})`) stays the shape every module here is written in.
		"exactOptionalPropertyTypes": false,
		"types": ["node"]
	},
	"include": ["src", ".tuval/tuval.config.ts", "vitest.config.ts"],
	// The slices that reach `@kampus/design` have their own lens, `tsconfig.design.json`, because
	// the package is source-consumed and is authored with `exactOptionalPropertyTypes: false`.
	// Excluding them here is what keeps the kernel on the strict flag; `typecheck` runs both.
	// `src/page/` is split rather than excluded whole: the three React modules reach the chat window
	// through the page's renderer table (#7573) and go to the other lens, while `dev-server.ts` is
	// Node-side, is imported by `src/bin.ts`, and stays here.
	// `src/pi/renderer-ref.ts` and `src/claude/renderer-ref.ts` still enter this project by import
	// from their rows, which is the point of those leaves: a row names its renderer without reaching
	// any of it.
	"exclude": [
		"node_modules",
		"src/shell/chat",
		"src/pi/window",
		"src/claude/window",
		"src/page/main.tsx",
		"src/page/AttachedDesk.tsx",
		"src/page/renderers.tsx",
		"src/page/attached-desk.unit.test.tsx"
	]
}
