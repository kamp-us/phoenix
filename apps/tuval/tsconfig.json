{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		// This is the Node lens over all of `src`: it has Node types, so a browser-only slice cannot
		// be caught here. The browser entry has its own lens, `tsconfig.browser.json`, rooted at
		// `src/page/main.tsx` with no Node types, so a `node:` import reachable from the page is a
		// plain type error there (#7836). `typecheck` runs both. Each Node-only slice still keeps
		// itself that way through its own `boundary.unit.test.ts`.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["node"]
	},
	"include": ["src", ".tuval/tuval.config.ts", "vitest.config.ts"],
	// The one slice that imports `@kampus/design` has its own lens, `tsconfig.design.json`, because
	// the package is source-consumed and is authored with `exactOptionalPropertyTypes: false`.
	// Excluding it here is what keeps the kernel on the strict flag; `typecheck` runs both.
	"exclude": ["node_modules", "src/shell/chat"]
}
