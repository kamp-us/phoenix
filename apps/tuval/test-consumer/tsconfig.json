		"declarationDir": "./node_modules/.tmp/dts",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["node"],
		"exactOptionalPropertyTypes": false
	},
	"include": ["program.ts"]
}
