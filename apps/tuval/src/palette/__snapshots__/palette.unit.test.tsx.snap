exports[`Palette > renders the same markup under either theme 1`] = `"<div data-scope="dialog" data-part="content" role="dialog" id="dialog:_id_:content" tabindex="-1" data-state="open" aria-modal="true" aria-labelledby="dialog:_id_:title" aria-describedby="dialog:_id_:description" data-size="lg" class="tuval-palette"><h2 data-scope="dialog" data-part="title" id="dialog:_id_:title">Command palette</h2><div data-scope="dialog" data-part="body"><div class="tuval-palette__body"><div data-scope="field" data-part="root" data-size="md" data-variant="primary" data-appearance="default" data-full-width="true" data-focus-ring="control" class="tuval-palette__input"><div data-scope="field" data-part="control" data-size="md"><input data-scope="field" data-part="input" role="combobox" aria-label="Run a spell" aria-autocomplete="list" aria-expanded="true" aria-controls="_id_-list" aria-activedescendant="_id_-option-0" autocomplete="off" spellcheck="false" placeholder="window close" id="_id_" type="text" value=""></div></div><div class="tuval-palette__announce" aria-live="polite"></div><div class="tuval-palette__list" id="_id_-list" role="listbox" aria-label="Spells"><div id="_id_-option-0" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="true" data-active=""><span class="tuval-palette__label">window close</span><span class="tuval-palette__describe">Close the focused window.</span></div><div id="_id_-option-1" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">window move</span><span class="tuval-palette__describe">Move the focused window.</span></div><div id="_id_-option-2" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">window focus</span><span class="tuval-palette__describe">Focus a window by id.</span></div><div id="_id_-option-3" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">workspace new</span><span class="tuval-palette__describe">Create a workspace.</span></div><div id="_id_-option-4" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">workspace activate</span><span class="tuval-palette__describe">Switch to a workspace.</span></div><div id="_id_-option-5" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">help</span><span class="tuval-palette__describe">List every spell this desk knows.</span></div><div id="_id_-option-6" class="tuval-palette__option" role="option" tabindex="-1" aria-selected="false"><span class="tuval-palette__label">wizard-inspect</span><span class="tuval-palette__describe">Inspect the wiring of a program.</span></div></div><p class="tuval-palette__detail">Close the focused window.</p><p class="tuval-palette__legend"><kbd data-scope="kbd" data-part="root" data-size="sm" class="kp-kbd">Tab</kbd> complete · <kbd data-scope="kbd" data-part="root" data-size="sm" class="kp-kbd">Enter</kbd> run · <kbd data-scope="kbd" data-part="root" data-size="sm" class="kp-kbd">Esc</kbd> close</p></div></div></div>"`;
