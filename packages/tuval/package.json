{
	"name": "tuval",
	"version": "0.0.0",
	"private": true,
	"description": "A localhost-first pi session workspace",
	"type": "module",
	"bin": {
		"tuval": "./dist/backend/bin.js"
	},
	"exports": {
		"./discovery": "./dist/shared/discovery.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm run build && vitest run"
	},
	"dependencies": {
		"@earendil-works/pi-client": "catalog:",
		"@earendil-works/pi-protocol": "catalog:",
		"@effect/platform-node": "catalog:",
		"@nkzw/fate": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
