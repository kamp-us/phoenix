{
	"name": "tuval",
	"version": "0.0.0",
	"private": true,
	"description": "A localhost-first pi session workspace",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./dist/extensions/tuval.js"
		]
	},
	"tuval": {
		"contractVersion": 1,
		"backend": [
			{
				"module": "./dist/backend/builtin-capability.js",
				"export": "makeTuvalBuiltinLayer"
			}
		],
		"frontend": {
			"panels": [
				{
					"key": "tuval.sessions",
					"asset": "./dist/frontend-shell/index.html"
				}
			]
		}
	},
	"bin": {
		"tuval": "./dist/backend/bin.js"
	},
	"exports": {
		"./discovery": "./dist/shared/discovery.js",
		"./lineage": "./dist/shared/lineage.js",
		"./live-session": "./dist/shared/live-session.js",
		"./resilience": "./dist/shared/resilience.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/build-frontend.mjs",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json --noEmit && tsc -p tsconfig.browser.json",
		"test": "pnpm run build && vitest run && pnpm run test:browser",
		"test:browser": "playwright test --config playwright.config.ts"
	},
	"dependencies": {
		"@earendil-works/pi-client": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-protocol": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/composer": "workspace:*",
		"@kampus/fate-effect": "workspace:*",
		"@manti-ui/react": "catalog:",
		"@manti-ui/styles": "catalog:",
		"@nkzw/fate": "catalog:",
		"@xyflow/react": "catalog:",
		"effect": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@playwright/test": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
