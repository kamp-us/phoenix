{
	"name": "@kampus/tuval-sdk",
	"version": "1.0.0",
	"description": "The Tuval SDK — the program authoring API, the window renderer contract, the AI-agent ports and the kernel runtime the desk app is built on",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval"
	},
	"type": "module",
	"exports": {
		"./authoring": "./src/authoring/index.ts",
		"./window": "./src/authoring/window.ts",
		"./ai-agent/ports": "./src/ai-agent/ports/index.ts",
		"./config": "./src/config.ts",
		"./kernel/*": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			"./authoring": {
				"types": "./dist/authoring/index.d.ts",
				"default": "./dist/authoring/index.js"
			},
			"./window": {
				"types": "./dist/authoring/window.d.ts",
				"default": "./dist/authoring/window.js"
			},
			"./ai-agent/ports": {
				"types": "./dist/ai-agent/ports/index.d.ts",
				"default": "./dist/ai-agent/ports/index.js"
			},
			"./config": {
				"types": "./dist/config.d.ts",
				"default": "./dist/config.js"
			},
			"./kernel/*": {
				"types": "./dist/*.d.ts",
				"default": "./dist/*.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"proof:outside": "node proof/outside.bin.ts"
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
