{
	"name": "fixture-plain-pi",
	"type": "module",
	"pi": {
		"extensions": [
			"./extension.js"
		]
	},
	"tuval": {
		"contractVersion": 1,
		"backend": [
			{
				"module": "./backend.js",
				"export": "makeLayer"
			}
		],
		"frontend": {
			"nodes": [
				{
					"key": "fixture.node",
					"asset": "./asset.js"
				}
			],
			"edges": [
				{
					"key": "fixture.edge",
					"asset": "./edge.js"
				}
			],
			"panels": [
				{
					"key": "fixture.panel",
					"asset": "./panel.js"
				}
			]
		}
	}
}
