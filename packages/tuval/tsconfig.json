{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"noEmit": true,
		// Relative imports carry an explicit `.ts` extension: the desk runs this source under Node's
		// native type-stripping with no bundler, where an extensionless specifier does not resolve.
		"allowImportingTsExtensions": true,
		// The lens this source was written under in `apps/tuval`, kept as is. `DOM` is here because the
		// window contract types a renderer's mount target (`shell/window/prefix-signal.ts` names
		// `Element`). `exactOptionalPropertyTypes` is off because `ai-agent/session-list.ts` does not yet
		// hold under it, and every consumer reads this source under its own lens with the flag off.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"exactOptionalPropertyTypes": false,
		"types": ["node"]
	},
	"include": ["src", "proof", "vitest.config.ts"]
}
