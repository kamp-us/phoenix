{
	"name": "@kampus/tuval-claude",
	"version": "1.0.0",
	"description": "Tuval's Claude harness — the claude-session program row, its Agent SDK adapter, kernel tools, history and window, on the @kampus/tuval-sdk kernel",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval-claude"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent": "./src/agent/index.ts",
		"./tools": "./src/tools/index.ts",
		"./window": "./src/window/index.ts",
		"./testing/window": "./src/window/claude-window.testing.ts",
		"./testing/scripted-query": "./src/agent/fixtures/scripted-query.ts",
		"./testing/history-fixtures": "./src/history/fixtures/load.ts",
		"./testing/initial-effort": "./src/proof/initial-effort.ts",
		"./testing/paging-replay": "./src/proof/paging-replay.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./agent": {
				"types": "./dist/agent/index.d.ts",
				"default": "./dist/agent/index.js"
			},
			"./tools": {
				"types": "./dist/tools/index.d.ts",
				"default": "./dist/tools/index.js"
			},
			"./window": {
				"types": "./dist/window/index.d.ts",
				"default": "./dist/window/index.js"
			},
			"./testing/window": {
				"types": "./dist/window/claude-window.testing.d.ts",
				"default": "./dist/window/claude-window.testing.js"
			},
			"./testing/scripted-query": {
				"types": "./dist/agent/fixtures/scripted-query.d.ts",
				"default": "./dist/agent/fixtures/scripted-query.js"
			},
			"./testing/history-fixtures": {
				"types": "./dist/history/fixtures/load.d.ts",
				"default": "./dist/history/fixtures/load.js"
			},
			"./testing/initial-effort": {
				"types": "./dist/proof/initial-effort.d.ts",
				"default": "./dist/proof/initial-effort.js"
			},
			"./testing/paging-replay": {
				"types": "./dist/proof/paging-replay.d.ts",
				"default": "./dist/proof/paging-replay.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/copy-src-assets.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@anthropic-ai/sdk": "catalog:",
		"@kampus/tuval-ui": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@kampus/tuval-sdk": "workspace:^",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@demlik/tea": "catalog:",
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@kampus/design": "workspace:*",
		"@kampus/tuval-sdk": "workspace:*",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"effect": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
