{
	"id": "coder",
	"version": 1,
	"machine": {
		"id": "coder",
		"initial": "pipeline",
		"context": {
			"issue": { "retries": 0, "maxRetries": 2 }
		},
		"states": {
			"pipeline": {
				"type": "parallel",
				"states": {
					"issue": {
						"initial": "queued",
						"states": {
							"queued": {
								"on": {
									"ISSUE.WIP": "build",
									"ISSUE.BLOCKED": "blocked"
								}
							},
							"build": {
								"on": {
									"ISSUE.DONE": "review",
									"ISSUE.BLOCKED": "blocked"
								}
							},
							"review": {
								"on": {
									"ISSUE.PASS": "ship",
									"ISSUE.BLOCKED": "blocked",
									"ISSUE.FAIL": [
										{
											"target": "build",
											"guard": "retriesRemaining",
											"actions": "incrementRetries"
										},
										{ "target": "frozen" }
									]
								}
							},
							"ship": {
								"on": {
									"ISSUE.DONE": "shipped",
									"ISSUE.WIP": "ship:queued",
									"ISSUE.BLOCKED": "human:cp-approval",
									"ISSUE.FAIL": [
										{
											"target": "build",
											"guard": "retriesRemaining",
											"actions": "incrementRetries"
										},
										{ "target": "frozen" }
									]
								}
							},
							"ship:queued": {
								"on": {
									"ISSUE.DONE": "shipped",
									"ISSUE.BLOCKED": "human:cp-approval",
									"ISSUE.WIP": [
										{
											"target": "ship:queued",
											"guard": "waitsRemaining",
											"actions": "incrementWaits"
										},
										{ "target": "human:queue-stall" }
									],
									"ISSUE.FAIL": [
										{
											"target": "build",
											"guard": "retriesRemaining",
											"actions": "incrementRetries"
										},
										{ "target": "frozen" }
									]
								}
							},
							"blocked": {
								"on": {
									"ISSUE.UNBLOCKED": "hist"
								}
							},
							"human:cp-approval": {
								"on": {
									"ISSUE.UNBLOCKED": "hist"
								}
							},
							"human:queue-stall": {
								"on": {
									"ISSUE.UNBLOCKED": "hist"
								}
							},
							"hist": { "type": "history" },
							"shipped": { "type": "final" },
							"frozen": {
								"type": "final",
								"on": {
									"ISSUE.UNBLOCKED": "hist"
								}
							}
						}
					}
				},
				"onDone": [{ "target": "complete", "guard": "noErrors" }, { "target": "tripped" }]
			},
			"complete": { "type": "final" },
			"tripped": { "type": "final" }
		}
	}
}
