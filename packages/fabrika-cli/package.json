	},
	"scripts": {
		"typecheck": "tsgo -p tsconfig.json",
		"test": "vitest run",
		"cli": "node src/bin.ts"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
