{
	"name": "@kampus/reels",
	"version": "0.0.0",
	"private": true,
	"description": "Renders vertical short-form videos (Reels / TikTok / Shorts) for fabrika and tuval from reel scripts",
	"type": "module",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"check": "node src/bin.ts check content",
		"render": "node src/bin.ts render"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@playwright/test": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
