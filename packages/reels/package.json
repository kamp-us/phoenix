{
	"name": "@kampus/reels",
	"version": "0.0.0",
	"private": true,
	"description": "Renders vertical short-form videos (Reels / TikTok / Shorts) for fabrika and tuval from reel scripts",
	"type": "module",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"check": "node src/bin.ts check",
		"render": "node src/bin.ts render",
		"studio": "remotion studio src/composition/index.ts"
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/design": "workspace:*",
		"@remotion/bundler": "catalog:",
		"@remotion/cli": "catalog:",
		"@remotion/renderer": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"remotion": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
