{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"exactOptionalPropertyTypes": false,
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"@kampus/tuval-hsbg": ["./src/index.ts"]
		},
		"plugins": [{ "name": "@effect/language-service", "includeSuggestionsInTsc": false }]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/window.tsx"]
}
