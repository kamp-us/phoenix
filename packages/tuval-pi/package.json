{
	"name": "@kampus/tuval-pi",
	"version": "0.0.0",
	"description": "Tuval's Pi harness — the pi-session program row, its loopback Pi host and client, kernel tools, history and window, on the @kampus/tuval-sdk kernel",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval-pi"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./ai-agent": "./src/ai-agent/index.ts",
		"./server": "./src/server/index.ts",
		"./window": "./src/window/index.ts",
		"./testing/faux": "./src/proof/faux.ts",
		"./testing/window": "./src/window/pi-window.testing.ts",
		"./testing/window-proof": "./src/window/proof.testing.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./ai-agent": {
				"types": "./dist/ai-agent/index.d.ts",
				"default": "./dist/ai-agent/index.js"
			},
			"./server": {
				"types": "./dist/server/index.d.ts",
				"default": "./dist/server/index.js"
			},
			"./window": {
				"types": "./dist/window/index.d.ts",
				"default": "./dist/window/index.js"
			},
			"./testing/faux": {
				"types": "./dist/proof/faux.d.ts",
				"default": "./dist/proof/faux.js"
			},
			"./testing/window": {
				"types": "./dist/window/pi-window.testing.d.ts",
				"default": "./dist/window/pi-window.testing.js"
			},
			"./testing/window-proof": {
				"types": "./dist/window/proof.testing.d.ts",
				"default": "./dist/window/proof.testing.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/copy-src-assets.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-client": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-protocol": "catalog:",
		"@kampus/tuval-ui": "workspace:*",
		"pi-subagents": "catalog:",
		"typebox": "catalog:",
		"ws": "catalog:"
	},
	"peerDependencies": {
		"@kampus/tuval-sdk": "workspace:*",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@demlik/tea": "catalog:",
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@kampus/design": "workspace:*",
		"@kampus/tuval-sdk": "workspace:*",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/ws": "catalog:",
		"effect": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
