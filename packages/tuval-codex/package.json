{
	"name": "@kampus/tuval-codex",
	"version": "1.0.0",
	"description": "Tuval's Codex harness — the codex-session program row, its codex app-server adapter, kernel tools, history and window, on the @kampus/tuval-sdk kernel",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval-codex"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./window": "./src/window/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./window": {
				"types": "./dist/window/index.d.ts",
				"default": "./dist/window/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/copy-src-assets.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@kampus/tuval-ui": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:"
	},
	"peerDependencies": {
		"@kampus/tuval-sdk": "workspace:^",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@kampus/tuval-sdk": "workspace:*",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"effect": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
