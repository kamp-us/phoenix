{
	// The emit lens for the published tarball, the SDK's (`packages/tuval/tsconfig.build.json`):
	// `rewriteRelativeImportExtensions` turns the explicit `.ts`/`.tsx` specifiers into `.js` so the
	// packed files resolve under plain `node`, and `composite` is off so a typecheck's build info
	// never marks an emptied `dist` as up to date.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"incremental": false,
		"noEmit": false,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": false
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-budget.ts"]
}
