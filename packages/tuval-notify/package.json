{
	"name": "@kampus/tuval-notify",
	"version": "0.1.0",
	"description": "A notifier for Tuval — take a message on a port, deliver it off the desk to a webhook, ntfy, or stdout, and say on the tile whether it landed",
	"license": "MIT",
	"author": "Can Sirin <mail@csirin.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval-notify"
	},
	"type": "module",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./window": {
			"types": "./dist/window.d.ts",
			"default": "./dist/window.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.window.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict && tsc -p tsconfig.window.json && effect-tsgo diagnostics --project tsconfig.window.json --strict",
		"lint": "biome check src .tuval",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@demlik/tea": "catalog:",
		"@kampus/tuval-sdk": "workspace:*",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@demlik/tea": "catalog:",
		"@effect/tsgo": "catalog:",
		"@kampus-apps/tuval": "workspace:*",
		"@kampus/tuval-claude": "workspace:*",
		"@kampus/tuval-sdk": "workspace:*",
		"@kampus/tuval-cron": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"effect": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
