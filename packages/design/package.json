{
	"name": "@kampus/design",
	"version": "0.0.0",
	"description": "Shared Kampüs UI primitives, design tokens, fonts, and accessibility contract",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/design"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./a11y": "./src/a11y/check.ts",
		"./Diff": "./src/Diff.tsx",
		"./tokens.css": "./src/tokens.css",
		"./fonts.css": "./src/fonts.css",
		"./visually-hidden.css": "./src/visually-hidden.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./a11y": {
				"types": "./dist/a11y/check.d.ts",
				"default": "./dist/a11y/check.js"
			},
			"./Diff": {
				"types": "./dist/Diff.d.ts",
				"default": "./dist/Diff.js"
			},
			"./tokens.css": "./dist/tokens.css",
			"./fonts.css": "./dist/fonts.css",
			"./visually-hidden.css": "./dist/visually-hidden.css"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/copy-src-assets.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run --config vitest.config.ts",
		"test:a11y": "vitest run --config vitest.a11y.config.ts"
	},
	"peerDependencies": {
		"axe-core": "catalog:",
		"fast-check": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"peerDependenciesMeta": {
		"axe-core": {
			"optional": true
		},
		"fast-check": {
			"optional": true
		}
	},
	"dependencies": {
		"@manti-ui/react": "catalog:",
		"@fontsource/ibm-plex-sans": "catalog:",
		"@fontsource/jetbrains-mono": "catalog:",
		"@pierre/diffs": "catalog:",
		"lucide-react": "catalog:",
		"marked": "catalog:",
		"mermaid": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"axe-core": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
