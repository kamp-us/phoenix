{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"noEmit": true,
		// Relative imports carry an explicit `.ts` extension: the desk runs this source under Node's
		// native type-stripping and Vite, with no emit step in between.
		"allowImportingTsExtensions": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		// Off for the cause `apps/tuval/tsconfig.design.json` gives: `@kampus/design` is consumed as
		// source and authored with the flag off, and its `.tsx` files are checked under this
		// project's options when this package imports them.
		"exactOptionalPropertyTypes": false,
		"types": ["node"]
	},
	"include": ["src", "vitest.config.ts"]
}
