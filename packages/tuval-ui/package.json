{
	"name": "@kampus/tuval-ui",
	"version": "0.0.0",
	"description": "Tuval's desk chat UI and shared agent window — the React surfaces an AI-agent program's window is built from, on the @kampus/tuval-sdk kernel",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kamp-us/phoenix.git",
		"directory": "packages/tuval-ui"
	},
	"type": "module",
	"exports": {
		"./chat": "./src/shell/chat/index.ts",
		"./agent-window": "./src/ai-agent/window/index.ts",
		"./desk": "./src/shell/desk/index.ts",
		"./keys": "./src/shell/keys/index.ts",
		"./forwarded-key": "./src/shell/ui/forwarded-key.tsx",
		"./input-modality": "./src/shell/ui/input-modality.ts",
		"./session-list": "./src/page/session-list.ts",
		"./session-transcript": "./src/page/session-transcript.ts",
		"./palette-call": "./src/palette/call.ts",
		"./testing/chat": "./src/shell/chat/chat.testing.ts",
		"./testing/agent-window": "./src/ai-agent/window/fixtures.ts",
		"./testing/inspector": "./src/ai-agent/window/inspector.testing.ts",
		"./testing/desk": "./src/shell/desk/fixtures.ts",
		"./testing/dom": "./src/shell/ui/dom.testing.ts",
		"./testing/palette": "./src/palette/fixtures.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			"./chat": {
				"types": "./dist/shell/chat/index.d.ts",
				"default": "./dist/shell/chat/index.js"
			},
			"./agent-window": {
				"types": "./dist/ai-agent/window/index.d.ts",
				"default": "./dist/ai-agent/window/index.js"
			},
			"./desk": {
				"types": "./dist/shell/desk/index.d.ts",
				"default": "./dist/shell/desk/index.js"
			},
			"./keys": {
				"types": "./dist/shell/keys/index.d.ts",
				"default": "./dist/shell/keys/index.js"
			},
			"./forwarded-key": {
				"types": "./dist/shell/ui/forwarded-key.d.ts",
				"default": "./dist/shell/ui/forwarded-key.js"
			},
			"./input-modality": {
				"types": "./dist/shell/ui/input-modality.d.ts",
				"default": "./dist/shell/ui/input-modality.js"
			},
			"./session-list": {
				"types": "./dist/page/session-list.d.ts",
				"default": "./dist/page/session-list.js"
			},
			"./session-transcript": {
				"types": "./dist/page/session-transcript.d.ts",
				"default": "./dist/page/session-transcript.js"
			},
			"./palette-call": {
				"types": "./dist/palette/call.d.ts",
				"default": "./dist/palette/call.js"
			},
			"./testing/chat": {
				"types": "./dist/shell/chat/chat.testing.d.ts",
				"default": "./dist/shell/chat/chat.testing.js"
			},
			"./testing/agent-window": {
				"types": "./dist/ai-agent/window/fixtures.d.ts",
				"default": "./dist/ai-agent/window/fixtures.js"
			},
			"./testing/inspector": {
				"types": "./dist/ai-agent/window/inspector.testing.d.ts",
				"default": "./dist/ai-agent/window/inspector.testing.js"
			},
			"./testing/desk": {
				"types": "./dist/shell/desk/fixtures.d.ts",
				"default": "./dist/shell/desk/fixtures.js"
			},
			"./testing/dom": {
				"types": "./dist/shell/ui/dom.testing.d.ts",
				"default": "./dist/shell/ui/dom.testing.js"
			},
			"./testing/palette": {
				"types": "./dist/palette/fixtures.d.ts",
				"default": "./dist/palette/fixtures.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/copy-src-assets.mjs",
		"prepack": "pnpm run build",
		"typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict",
		"test": "vitest run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@kampus/design": "workspace:*",
		"@tanstack/react-virtual": "catalog:"
	},
	"peerDependencies": {
		"@kampus/tuval-sdk": "workspace:*",
		"effect": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@kampus/tuval-sdk": "workspace:*",
		"@testing-library/dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"effect": "catalog:",
		"fast-check": "catalog:",
		"jsdom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"volta": {
		"node": "26.2.0"
	}
}
