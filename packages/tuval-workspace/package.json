{
  "name": "@kampus/tuval-workspace",
  "version": "0.1.0",
  "description": "Isolation for Tuval — a disposable worktree, port, env and scratch DB per agent, provisioned from declared inputs and torn down on close",
  "license": "MIT",
  "author": "Can Sirin <mail@csirin.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamp-us/phoenix.git",
    "directory": "packages/tuval-workspace"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./window": {
      "types": "./dist/window.d.ts",
      "default": "./dist/window.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.window.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && effect-tsgo diagnostics --project tsconfig.json --strict && tsc -p tsconfig.window.json && effect-tsgo diagnostics --project tsconfig.window.json --strict",
    "lint": "biome check src .tuval examples",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@demlik/tea": "catalog:",
    "@kampus/tuval": "workspace:*",
    "effect": "catalog:tuval",
    "react": "catalog:"
  },
  "devDependencies": {
    "@demlik/tea": "catalog:",
    "@effect/tsgo": "catalog:",
    "@kampus/tuval": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:tuval",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
